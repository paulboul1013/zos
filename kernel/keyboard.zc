// ZOS PS/2 keyboard driver (Task 8).
//
// The controller presents IBM PC/AT set-1 make/break scancodes on port 0x60.
// This module intentionally stops at a small, deterministic ASCII surface:
// letters, number-row digits, space, Enter, Backspace, and Shift.  Modifier
// and break handling stay here so the interrupt and shell tasks can consume a
// single byte without duplicating PS/2 protocol details.

def KEYBOARD_DATA_PORT: u16 = (u16)0x60;
def PIC_MASTER_DATA_PORT: u16 = (u16)0x21;
def PIC_MASTER_COMMAND_PORT: u16 = (u16)0x20;
def PIC_END_OF_INTERRUPT: u8 = (u8)0x20;
def KEYBOARD_IRQ_MASK: u8 = (u8)0x02;
def KEYBOARD_BREAK_MASK: u8 = (u8)0x80;
def KEYBOARD_LEFT_SHIFT: u8 = (u8)0x2a;
def KEYBOARD_RIGHT_SHIFT: u8 = (u8)0x36;
def KEYBOARD_LEFT_SHIFT_BREAK: u8 = (u8)0xaa;
def KEYBOARD_RIGHT_SHIFT_BREAK: u8 = (u8)0xb6;
def KEYBOARD_QUEUE_CAPACITY: u32 = 64;

// Return values are ASCII bytes.  Zero means that the scancode is a modifier,
// a key-release event, an unsupported key, or that no byte was available.
def KEY_EVENT_NONE: u8 = (u8)0;
def KEY_EVENT_ENTER: u8 = (u8)'\n';
def KEY_EVENT_BACKSPACE: u8 = (u8)'\b';

// Defined by arch/i686/io.zc.  Keep the port-I/O boundary explicit so this
// module can be transpiled and syntax-checked as an independent work slice.
extern fn io_inb(port: u16) -> u8;
extern fn io_outb(port: u16, value: u8);

let _keyboard_shift: u8 = (u8)0;
let _keyboard_queue: u8[64];
let _keyboard_queue_head: u32 = 0;
let _keyboard_queue_tail: u32 = 0;
let _keyboard_queue_drop_count: u32 = 0;

fn keyboard_reset() {
    _keyboard_shift = (u8)0;
    _keyboard_queue_head = 0;
    _keyboard_queue_tail = 0;
    _keyboard_queue_drop_count = 0;
}

// Initialize the keyboard-facing part of the PIC contract.  Preserve every
// existing master-PIC mask bit and clear only IRQ1 (the PS/2 keyboard line).
// IRQ0 remains untouched so timer setup can own its enable policy.  IDT gate
// installation and STI are intentionally owned by interrupts/kernel code.
fn keyboard_init() {
    keyboard_reset();
    let master_mask: u8 = io_inb(PIC_MASTER_DATA_PORT);
    io_outb(PIC_MASTER_DATA_PORT, master_mask & ~KEYBOARD_IRQ_MASK);
}

fn keyboard_shift_active() -> u8 {
    return _keyboard_shift;
}

fn keyboard_read_scancode() -> u8 {
    return io_inb(KEYBOARD_DATA_PORT);
}

// IRQ1 is the only producer and the shell task is the only consumer. One
// storage slot remains empty so equal head/tail values always mean empty.
// Dropping the newest byte on overflow preserves the order of queued input.
fn _keyboard_queue_push(ch: u8) {
    let next: u32 = _keyboard_queue_head + 1;
    if next >= KEYBOARD_QUEUE_CAPACITY {
        next = 0;
    }

    if next == _keyboard_queue_tail {
        _keyboard_queue_drop_count = _keyboard_queue_drop_count + 1;
        return;
    }

    _keyboard_queue[_keyboard_queue_head] = ch;
    _keyboard_queue_head = next;
}

fn keyboard_queue_pop() -> u8 {
    if _keyboard_queue_tail == _keyboard_queue_head {
        return KEY_EVENT_NONE;
    }

    let ch: u8 = _keyboard_queue[_keyboard_queue_tail];
    _keyboard_queue_tail = _keyboard_queue_tail + 1;
    if _keyboard_queue_tail >= KEYBOARD_QUEUE_CAPACITY {
        _keyboard_queue_tail = 0;
    }
    return ch;
}

fn keyboard_queue_count() -> u32 {
    if _keyboard_queue_head >= _keyboard_queue_tail {
        return _keyboard_queue_head - _keyboard_queue_tail;
    }
    return KEYBOARD_QUEUE_CAPACITY -
           (_keyboard_queue_tail - _keyboard_queue_head);
}

fn keyboard_queue_dropped() -> u32 {
    return _keyboard_queue_drop_count;
}

// Consume one IRQ1 byte, enqueue translated input, and release the master
// PIC's in-service bit. EOI is sent even for a modifier, release, unsupported
// key, or full queue so one scancode cannot block later interrupts.
fn keyboard_handle_irq() {
    let scancode: u8 = keyboard_read_scancode();
    let ch: u8 = keyboard_handle_scancode(scancode);
    if ch != KEY_EVENT_NONE {
        _keyboard_queue_push(ch);
    }
    io_outb(PIC_MASTER_COMMAND_PORT, PIC_END_OF_INTERRUPT);
}

fn _keyboard_letter(scancode: u8) -> u8 {
    if scancode >= 0x10 && scancode <= 0x19 {
        return (u8)"qwertyuiop"[scancode - 0x10];
    }
    if scancode >= 0x1e && scancode <= 0x26 {
        return (u8)"asdfghjkl"[scancode - 0x1e];
    }
    if scancode >= 0x2c && scancode <= 0x32 {
        return (u8)"zxcvbnm"[scancode - 0x2c];
    }
    return KEY_EVENT_NONE;
}

fn _keyboard_number(scancode: u8) -> u8 {
    if scancode < 0x02 || scancode > 0x0b {
        return KEY_EVENT_NONE;
    }

    if _keyboard_shift == 0 {
        return (u8)"1234567890"[scancode - 0x02];
    }
    return (u8)"!@#$%^&*()"[scancode - 0x02];
}

fn _keyboard_shifted_letter(ch: u8) -> u8 {
    if _keyboard_shift == 0 { return ch; }
    if ch >= (u8)'a' && ch <= (u8)'z' {
        return ch - ((u8)'a' - (u8)'A');
    }
    return ch;
}

// Translate one set-1 scancode. The IRQ handler and deterministic unit tests
// share this stateful boundary. Only make codes produce ASCII; break codes
// update Shift and return zero.
fn keyboard_handle_scancode(scancode: u8) -> u8 {
    if scancode == KEYBOARD_LEFT_SHIFT || scancode == KEYBOARD_RIGHT_SHIFT {
        _keyboard_shift = (u8)1;
        return KEY_EVENT_NONE;
    }

    if scancode == KEYBOARD_LEFT_SHIFT_BREAK ||
       scancode == KEYBOARD_RIGHT_SHIFT_BREAK {
        _keyboard_shift = (u8)0;
        return KEY_EVENT_NONE;
    }

    // Ignore all non-Shift break codes.  Extended (0xe0) prefixes and
    // navigation keys are deliberately outside this MVP slice.
    if (scancode & KEYBOARD_BREAK_MASK) != 0 {
        return KEY_EVENT_NONE;
    }

    if scancode == 0x1c { return KEY_EVENT_ENTER; }
    if scancode == 0x0e { return KEY_EVENT_BACKSPACE; }
    if scancode == 0x39 { return (u8)' '; }

    let number: u8 = _keyboard_number(scancode);
    if number != KEY_EVENT_NONE {
        return number;
    }

    let letter: u8 = _keyboard_letter(scancode);
    if letter != KEY_EVENT_NONE {
        return _keyboard_shifted_letter(letter);
    }

    return KEY_EVENT_NONE;
}
