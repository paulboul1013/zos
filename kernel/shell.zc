// ZOS keyboard shell (Task 10).
//
// The shell is deliberately small and freestanding.  It owns one fixed-size
// command buffer and consumes ASCII bytes produced by keyboard.zc. The shell
// task calls `shell_feed_char` outside interrupt context; command execution
// stays here so keyboard and interrupt code do not know shell policy.

// A command may span more than one complete 80x25 VGA screen. The console
// handles visual wrapping and scrolling while this buffer preserves input
// for command dispatch and Backspace handling.
def SHELL_BUFFER_CAPACITY: u32 = 4096;

extern fn console_putc(ch: u8);
extern fn console_write(text: const char*);
extern fn console_clear();
extern fn keyboard_read_blocking() -> u8;

// Keep one byte for the terminating zero.  The buffer is only compared by
// this module; it does not rely on libc string functions or hosted stdlib.
let _shell_buffer: u8[4096];
let _shell_length: u32 = 0;

fn _shell_reset_buffer() {
    _shell_length = 0;
    _shell_buffer[0] = (u8)0;
}

fn _shell_equals(text: const char*) -> bool {
    let index: u32 = 0;

    if text == NULL {
        return false;
    }

    while text[index] != 0 {
        if index >= _shell_length {
            return false;
        }
        if _shell_buffer[index] != (u8)text[index] {
            return false;
        }
        index = index + 1;
    }

    return index == _shell_length;
}

fn _shell_execute() {
    if _shell_length == 0 {
        return;
    }

    if _shell_equals("clear") {
        console_clear();
        return;
    }

    console_write("unknown command\n");
}

fn shell_init() {
    _shell_reset_buffer();
    console_write("zos> ");
}

// Feed one ASCII byte.  Printable bytes are echoed and appended until the
// fixed buffer is full; Enter executes and starts a fresh prompt; Backspace
// removes the last byte and erases its echo.  CR is accepted alongside LF so
// callers can pass either keyboard convention.
fn shell_feed_char(ch: u8) {
    if ch == (u8)'\n' || ch == (u8)'\r' {
        console_putc((u8)'\n');
        _shell_execute();
        _shell_reset_buffer();
        console_write("zos> ");
        return;
    }

    if ch == (u8)'\b' {
        if _shell_length > 0 {
            _shell_length = _shell_length - 1;
            _shell_buffer[_shell_length] = (u8)0;
            console_putc((u8)'\b');
        }
        return;
    }

    if ch < (u8)' ' || ch > (u8)'~' {
        return;
    }

    if _shell_length >= SHELL_BUFFER_CAPACITY - 1 {
        return;
    }

    _shell_buffer[_shell_length] = ch;
    _shell_length = _shell_length + 1;
    _shell_buffer[_shell_length] = (u8)0;
    console_putc(ch);
}

// Long-lived Ring 0 consumer for the keyboard IRQ queue. It drains queued
// input in FIFO order and blocks whenever no input is pending.
fn shell_task() {
    shell_init();

    while true {
        let ch: u8 = keyboard_read_blocking();
        if ch == (u8)0 {
            console_write("shell task: invalid wait context\n");
            return;
        }
        shell_feed_char(ch);
    }
}
