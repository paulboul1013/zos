// ZOS VGA text console.
//
// Text layout and cursor policy stay in Zenc.  Only the volatile write to
// the VGA memory window crosses into raw C, because that is the boundary
// where Zenc currently cannot express a volatile MMIO pointer reliably.

def CONSOLE_COLUMNS: u16 = 80;
def CONSOLE_ROWS: u16 = 25;
def CONSOLE_CRTC_INDEX_PORT: u16 = 0x3D4;
def CONSOLE_CRTC_DATA_PORT: u16 = 0x3D5;
def CONSOLE_CURSOR_HIGH: u8 = 0x0E;
def CONSOLE_CURSOR_LOW: u8 = 0x0F;

raw {
#ifdef ZOS_VGA_TEST
    extern uint16_t _zos_vga_test_text[2000];
    static volatile uint16_t* const _zos_vga_text = _zos_vga_test_text;
#else
    static volatile uint16_t* const _zos_vga_text =
        (volatile uint16_t*)0xB8000;
#endif

    static void _zos_vga_write_cell(uint32_t index, uint16_t value) {
        _zos_vga_text[index] = value;
    }

    static void _zos_vga_fill(uint16_t value) {
        uint32_t i;
        for (i = 0; i < 2000U; ++i) {
            _zos_vga_text[i] = value;
        }
    }

    static void _zos_vga_scroll_up(uint16_t blank) {
        uint32_t i;
        for (i = 0; i < 1920U; ++i) {
            _zos_vga_text[i] = _zos_vga_text[i + 80U];
        }
        for (i = 1920U; i < 2000U; ++i) {
            _zos_vga_text[i] = blank;
        }
    }
}

extern fn _zos_vga_write_cell(index: u32, value: u16);
extern fn _zos_vga_fill(value: u16);
extern fn _zos_vga_scroll_up(blank: u16);
extern fn io_outb(port: u16, value: u8);

let _console_column: u16 = 0;
let _console_row: u16 = 0;
let _console_color: u8 = 0x07;

fn _console_cell(ch: u8) -> u16 {
    return ((u16)_console_color << 8) | (u16)ch;
}

// Keep the VGA hardware cursor aligned with the logical console position.
// VGA CRTC register 0x0E/0x0F stores a character-cell offset in the 80x25
// text buffer, so the shell prompt `zos> ` leaves the cursor at column 5.
fn _console_set_cursor() {
    let position: u32 = (u32)_console_row * (u32)CONSOLE_COLUMNS +
                        (u32)_console_column;

    io_outb((u16)CONSOLE_CRTC_INDEX_PORT, (u8)CONSOLE_CURSOR_LOW);
    io_outb((u16)CONSOLE_CRTC_DATA_PORT, (u8)(position & 0xFF));
    io_outb((u16)CONSOLE_CRTC_INDEX_PORT, (u8)CONSOLE_CURSOR_HIGH);
    io_outb((u16)CONSOLE_CRTC_DATA_PORT, (u8)((position >> 8) & 0xFF));
}

fn _console_redraw_cursor() {
    let index: u32 = (u32)_console_row * (u32)CONSOLE_COLUMNS +
                     (u32)_console_column;
    _zos_vga_write_cell(index, _console_cell((u8)' '));
}

// Preserve the latest 24 rows when output advances beyond the bottom of the
// 80x25 text window, then continue writing on the cleared final row.
fn _console_scroll() {
    if _console_row >= CONSOLE_ROWS {
        _zos_vga_scroll_up(_console_cell((u8)' '));
        _console_row = (u16)((u32)CONSOLE_ROWS - 1);
    }
}

fn console_set_color(color: u8) {
    _console_color = color;
}

fn console_clear() {
    _zos_vga_fill(_console_cell((u8)' '));
    _console_column = (u16)0;
    _console_row = (u16)0;
    _console_set_cursor();
}

fn console_init() {
    console_clear();
}

fn console_putc(ch: u8) {
    if ch == (u8)'\n' {
        _console_column = (u16)0;
        _console_row = _console_row + 1;
    } else if ch == (u8)'\r' {
        _console_column = (u16)0;
    } else if ch == (u8)'\b' {
        if _console_column > 0 {
            _console_column = _console_column - 1;
            _console_redraw_cursor();
        } else if _console_row > 0 {
            _console_row = _console_row - 1;
            _console_column = (u16)((u32)CONSOLE_COLUMNS - 1);
            _console_redraw_cursor();
        }
    } else {
        let index: u32 = (u32)_console_row * (u32)CONSOLE_COLUMNS +
                         (u32)_console_column;
        _zos_vga_write_cell(index, _console_cell(ch));
        _console_column = _console_column + 1;
        if _console_column >= CONSOLE_COLUMNS {
            _console_column = (u16)0;
            _console_row = _console_row + 1;
        }
    }

    _console_scroll();
    _console_set_cursor();
}

fn console_write(text: const char*) {
    if text == NULL {
        return;
    }

    let index: usize = 0;
    while text[index] != 0 {
        console_putc((u8)text[index]);
        index = index + 1;
    }
}
